NODE_ENV=development
PORT=3000
# Orígenes web permitidos separados por comas (obligatorio en producción). La app nativa no usa CORS.
# CORS_ORIGINS=https://app.lynkdrive.es
# Peticiones por minuto e IP (por defecto 300). Detrás de proxy (Render) define TRUST_PROXY=1.
# RATE_LIMIT_PER_MINUTE=300
# TRUST_PROXY=1
TYPEORM_SYNCHRONIZE=false
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/fyf_dev
SUPABASE_JWT_SECRET=<SUPABASE_JWT_SECRET_OPTIONAL>
SUPABASE_JWKS_URL=https://<SUPABASE_PROJECT_REF>.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_JWT_AUDIENCE=authenticated
SUPABASE_URL=https://<SUPABASE_PROJECT_REF>.supabase.co
SUPABASE_STORAGE_URL=https://<SUPABASE_PROJECT_REF>.supabase.co/storage/v1
SUPABASE_ANON_KEY=<SUPABASE_ANON_KEY>
SUPABASE_SERVICE_ROLE_KEY=<SUPABASE_SERVICE_ROLE_KEY>
SUPABASE_STORAGE_VEHICLES_BUCKET=vehicles
SUPABASE_STORAGE_AVATARS_BUCKET=avatars
SUPABASE_STORAGE_USER_DOCS_BUCKET=documents
SUPABASE_STORAGE_DOCUMENTS_BUCKET=documents
SUPABASE_STORAGE_CHECKLISTS_BUCKET=checklists
SUPABASE_STORAGE_VEHICLES_PUBLIC=true
SUPABASE_STORAGE_AVATARS_PUBLIC=true
SUPABASE_STORAGE_DOCUMENTS_PUBLIC=false
SUPABASE_STORAGE_CHECKLISTS_PUBLIC=false
# Caducidad de las URLs firmadas de buckets privados (por defecto 900 s, máximo 3600).
SUPABASE_SIGNED_URL_TTL_SECONDS=900
# Stripe (modo test). Sin STRIPE_SECRET_KEY la API funciona en modo prototipo (sin cobros reales).
STRIPE_SECRET_KEY=<STRIPE_SECRET_KEY_sk_test_...>
# Clave publicable que la app recibe via /payments/config para abrir el PaymentSheet.
STRIPE_PUBLISHABLE_KEY=<STRIPE_PUBLISHABLE_KEY_pk_test_...>
# Secreto de firma del webhook (stripe listen --forward-to ... lo imprime como whsec_...).
STRIPE_WEBHOOK_SECRET=<STRIPE_WEBHOOK_SECRET_whsec_...>
# Comision de plataforma (application fee) en % sobre el total cobrado. Por defecto 10.
STRIPE_APPLICATION_FEE_PERCENT=10
# Pais de las cuentas Connect Express de propietarios. Por defecto ES.
STRIPE_CONNECT_COUNTRY=ES
# URL publica de esta API (para return/refresh del onboarding Connect).
API_PUBLIC_URL=http://localhost:3000/api
# Opcional: sobreescribir URLs de retorno del onboarding Connect.
# STRIPE_CONNECT_RETURN_URL=http://localhost:3000/api/payments/connect/return
# STRIPE_CONNECT_REFRESH_URL=http://localhost:3000/api/payments/connect/refresh
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
NOMINATIM_DEFAULT_COUNTRY_CODES=es
NOMINATIM_USER_AGENT=lynkdrive-tfg/0.1 (contact: your-email@example.com)
NOMINATIM_TIMEOUT_MS=3500
NOMINATIM_CACHE_TTL_MS=900000
NOMINATIM_CACHE_MAX_ENTRIES=500
