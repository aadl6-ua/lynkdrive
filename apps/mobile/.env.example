EXPO_PUBLIC_API_URL=http://localhost:3000/api
# Android emulador (AVD): usa 10.0.2.2
# EXPO_PUBLIC_API_URL=http://10.0.2.2:3000/api
# Dispositivo físico Android/iOS: usa la IP local de tu Mac
# EXPO_PUBLIC_API_URL=http://<TU_IP_LOCAL>:3000/api

# URL base de Supabase para resolver previsualizaciones de imagen en buckets publicos.
EXPO_PUBLIC_SUPABASE_URL=https://<SUPABASE_PROJECT_REF>.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=<SUPABASE_ANON_KEY>
# Alternativa explicita si prefieres no derivar desde EXPO_PUBLIC_SUPABASE_URL:
# EXPO_PUBLIC_SUPABASE_STORAGE_URL=https://<SUPABASE_PROJECT_REF>.supabase.co/storage/v1

# Buckets que son publicos y se pueden renderizar directamente en la app.
EXPO_PUBLIC_SUPABASE_PUBLIC_BUCKETS=vehicles,avatars

# URL pública de la web (Vercel). El email de recuperación de contraseña redirige aquí,
# también cuando se pide desde la app nativa. Añádela en Supabase > Auth > URL Configuration.
# EXPO_PUBLIC_WEB_URL=https://app.lynkdrive.es

# Datos del titular que aparecen en los textos legales.
# EXPO_PUBLIC_LEGAL_OWNER_NAME=LynkDrive
# EXPO_PUBLIC_LEGAL_CONTACT_EMAIL=privacidad@lynkdrive.es
